; Semantic Versioning's render: a version's events written as its text,
; `major.minor.patch[-prerelease][+build]`. This is a library of
; definitions, each named `semver-...`, which a host links with its own
; program (alchemy's `compile_sources`); its entry point is
; `semver-render`, and nothing else here is the host's to call.
;
; The tree is the one the reader builds, an object whose members are
; `major`, `minor` and `patch`, `prerelease` (a list of identifiers, a
; number for one spelled in digits and a string for any other) and
; `build` (a list of identifiers, each a string), or one the embedding
; (`alchemy/embed.alc`) accepted, which may also give:
;
; - a `major`, `minor` or `patch` as a string of digits, which is how
;   the Rust reader keeps one past 2^53 - 1, where a number would round;
; - a `prerelease` or `build` as one string of identifiers and dots,
;   written as it is, or as null, the empty string or an empty list, none
;   of which is written;
; - a build identifier as a number spelled in digits;
; - members of its own, which are not written.
;
; A number is written as its text, its lexeme or as JSON writes it, and
; that text must be digits alone: a version's numbers are whole, and
; alchemy has no arithmetic to write `1.0` or `1e3` as `1`. A string of
; digits must not begin with a zero, unless it is `0`, since the
; specification forbids that in a version core and in a numeric
; identifier; it is told by reading `0.` and the digits as a number,
; which is below `0.1` exactly when the first digit is zero (a string
; that begins with a zero and sixteen nines rounds to `0.1` and is not
; told). An identifier holds `0-9`, `A-Z`, `a-z` and `-` and is not empty;
; a string of identifiers holds those and `.`, and its own structure (an
; empty identifier between two dots, a numeric identifier's leading zero)
; is not checked, since alchemy reads no character by its position.
;
; The text ends with no line break, since the reader takes one as a
; character no version has. It is written once, at the root's end, so a
; tree that is not a version writes nothing before it fails: a root that
; is not an object, a version without its major, minor or patch, or a
; value of the wrong kind fails with TARGET_VALUE_UNREPRESENTABLE, saying
; what a version needs, and events no tree has fail with
; PROTOCOL_ORDER_ERROR.
;
; The state is a stack of markers, one for each container the render is
; inside. The version's is `[:version phase major minor patch prerelease
; build]`, its phase `:key` while a member's key is due and `[:value
; name]` while its value is, each part `:none` or its text (a prerelease
; or a build the vector of its identifiers' texts, or one string). Above
; it, `[:ids name texts]` is a list of identifiers being read, and
; `[:skip open]` a member that is not written, `open` holding a marker
; for each of its containers that is open (`:object`, `:member` once its
; key is read, `:array`), so its events are held to a tree's order too.
; Once the version is written the state is `[:done]`, and nothing may
; follow it.

; What a version is, for the failures.
def semver-needs
  "a version is an object whose major, minor and patch are whole numbers written in digits, with an optional prerelease and build, each a list of identifiers or one string of them"

; The characters of a number, of an identifier, and of a string of
; identifiers, as code point ranges.
def semver-digits [[48 57]]
def semver-identifier-chars [[45 45] [48 57] [65 90] [97 122]]
def semver-dotted-chars [[45 46] [48 57] [65 90] [97 122]]

def semver-fail [what]
  fail :unrepresentable (string-join "" ["the document is not a version: " what "; " semver-needs])

; A value's kind, in words.
def semver-kind [value]
  match (kind value)
    case :null "null"
    case :boolean "a boolean"
    case :number "a number"
    case :string "a string"
    case _ "a container"

; Whether a string of digits begins with a zero and is not `0`.
def semver-leading-zero [s]
  match (compare (length s) 1)
    case :greater
      match (compare (number (string-join "" ["0." s])) (number "0.1"))
        case :less true
        case _ false
    case _ false

; A number's text, which must be digits alone.
def semver-number [what value]
  match (number-class value)
    case :finite
      let [text (scalar-text csv-options value)]
        if (chars-within semver-digits text)
          text
          semver-fail (string-join "" [what " is " text ", which is not a whole number written in digits"])
    case _ (semver-fail (string-join "" [what " is a number that is not finite"]))

; A string of digits, with no leading zero.
def semver-digit-string [what value]
  match (compare (length value) 0)
    case :greater
      if (chars-within semver-digits value)
        if (semver-leading-zero value)
          semver-fail (string-join "" [what " is " (quoted value) ", which begins with a zero"])
          value
        semver-fail (string-join "" [what " is " (quoted value) ", which is not digits"])
    case _ (semver-fail (string-join "" [what " is the empty string"]))

; The text of a major, minor or patch.
def semver-core [name value]
  match (kind value)
    case :number (semver-number name value)
    case :string (semver-digit-string name value)
    case _ (semver-fail (string-join "" [name " is " (semver-kind value)]))

; The text of an identifier of a prerelease or a build: a number in
; digits, or a string of an identifier's characters, which in a
; prerelease must not be digits with a leading zero.
def semver-identifier [name value]
  match (kind value)
    case :number (semver-number (string-join "" ["an identifier of the " name]) value)
    case :string
      match (compare (length value) 0)
        case :greater
          if (chars-within semver-identifier-chars value)
            if (chars-within semver-digits value)
              match name
                case "prerelease" (semver-digit-string "an identifier of the prerelease" value)
                case _ value
              value
            semver-fail (string-join "" ["an identifier of the " name " is " (quoted value) ", where an identifier holds 0-9, A-Z, a-z and -"])
        case _ (semver-fail (string-join "" ["an identifier of the " name " is the empty string"]))
    case _ (semver-fail (string-join "" ["an identifier of the " name " is " (semver-kind value)]))

; A prerelease or a build given as a scalar: one string of identifiers,
; written as it is, or null or the empty string, which is not written.
def semver-optional [name value]
  match (kind value)
    case :null :none
    case :string
      match value
        case "" :none
        case _
          if (chars-within semver-dotted-chars value)
            value
            semver-fail (string-join "" ["the " name " is " (quoted value) ", where its identifiers hold 0-9, A-Z, a-z and - and are joined by dots"])
    case _ (semver-fail (string-join "" ["the " name " is " (semver-kind value) ", where it is a list of identifiers or one string of them"]))

; The top marker, or :none before the root value.
def semver-top [s]
  match (count s)
    case 0 :none
    case _ (top s)

; The top marker replaced.
def semver-mark [marker s]
  push marker (pop s)

; The version's marker with one part set and its next key due.
def semver-set [m name text]
  match m
    case [:version _ ma mi pa pr bu]
      match name
        case "major" [:version :key text mi pa pr bu]
        case "minor" [:version :key ma text pa pr bu]
        case "patch" [:version :key ma mi text pr bu]
        case "prerelease" [:version :key ma mi pa text bu]
        case "build" [:version :key ma mi pa pr text]

; The version's marker in another phase.
def semver-phase [m phase]
  match m
    case [:version _ ma mi pa pr bu] [:version phase ma mi pa pr bu]

; A key of the version: its part's value is due, or a member that is not
; written begins.
def semver-key [s m name]
  match name
    case "major" (transition (semver-mark (semver-phase m [:value name]) s) [])
    case "minor" (transition (semver-mark (semver-phase m [:value name]) s) [])
    case "patch" (transition (semver-mark (semver-phase m [:value name]) s) [])
    case "prerelease" (transition (semver-mark (semver-phase m [:value name]) s) [])
    case "build" (transition (semver-mark (semver-phase m [:value name]) s) [])
    case _ (transition (push [:skip []] s) [])

; A scalar where a part's value is due.
def semver-part [s m name value]
  match name
    case "prerelease" (transition (semver-mark (semver-set m name (semver-optional name value)) s) [])
    case "build" (transition (semver-mark (semver-set m name (semver-optional name value)) s) [])
    case _ (transition (semver-mark (semver-set m name (semver-core name value)) s) [])

; A container where a part's value is due: the list of a prerelease's or
; a build's identifiers, and nothing else.
def semver-open [s name container]
  match [name container]
    case ["prerelease" :array] (transition (push [:ids name []] s) [])
    case ["build" :array] (transition (push [:ids name []] s) [])
    case [_ :array] (semver-fail (string-join "" [name " is a list"]))
    case _ (semver-fail (string-join "" [name " is an object"]))

; A list of identifiers closes into its part; an empty one is not
; written.
def semver-ids-end [s name texts]
  let [rest (pop s)]
    match (count texts)
      case 0 (transition (semver-mark (semver-set (top rest) name :none) rest) [])
      case _ (transition (semver-mark (semver-set (top rest) name texts) rest) [])

; A prerelease or a build after its sign, or nothing.
def semver-tail [sign part]
  match part
    case :none ""
    case _
      match (kind part)
        case :string (string-join "" [sign part])
        case _ (string-join "" [sign (string-join "." part)])

; The version's text, once its root ends.
def semver-text [m]
  match m
    case [:version _ :none _ _ _ _] (semver-fail "it has no major")
    case [:version _ _ :none _ _ _] (semver-fail "it has no minor")
    case [:version _ _ _ :none _ _] (semver-fail "it has no patch")
    case [:version _ ma mi pa pr bu]
      string-join ""
        [(string-join "." [ma mi pa]) (semver-tail "-" pr) (semver-tail "+" bu)]

; A member that is not written has had its value: the version waits for
; its next key.
def semver-skip-done [s]
  transition (pop s) []

; A value completed inside a member that is not written.
def semver-skip-value [s open]
  match (semver-top open)
    case :none (semver-skip-done s)
    case :member (transition (semver-mark [:skip (semver-mark :object open)] s) [])
    case :array (transition s [])
    case :object (fail :protocol-order "the events hold a value where a key is due, which a tree's never do")

; A container opens inside a member that is not written.
def semver-skip-open [s open container]
  match (semver-top open)
    case :none (transition (semver-mark [:skip (push container open)] s) [])
    case :member (transition (semver-mark [:skip (push container (semver-mark :object open))] s) [])
    case :array (transition (semver-mark [:skip (push container open)] s) [])
    case :object (fail :protocol-order "the events hold a value where a key is due, which a tree's never do")

; A container closes inside a member that is not written; the last one
; ends the member's value.
def semver-skip-close [s open container]
  match [(semver-top open) container]
    case [:object :object] (semver-skip-closed s (pop open))
    case [:array :array] (semver-skip-closed s (pop open))
    case _ (fail :protocol-order "the events end a container that is not open, or one whose member has no value, which a tree's never do")

def semver-skip-closed [s open]
  match (count open)
    case 0 (semver-skip-done s)
    case _ (transition (semver-mark [:skip open] s) [])

; Inside a member that is not written.
def semver-skip [s open event]
  match event
    case object-start (semver-skip-open s open :object)
    case array-start (semver-skip-open s open :array)
    case (key name)
      match (semver-top open)
        case :object (transition (semver-mark [:skip (semver-mark :member open)] s) [])
        case _ (fail :protocol-order "the events hold a key where a value is due, which a tree's never do")
    case (scalar value) (semver-skip-value s open)
    case object-end (semver-skip-close s open :object)
    case array-end (semver-skip-close s open :array)

; The root: a version is an object.
def semver-root [event]
  match event
    case object-start (transition [[:version :key :none :none :none :none :none]] [])
    case array-start (semver-fail "its root is a list")
    case (scalar value) (semver-fail (string-join "" ["its root is " (semver-kind value)]))
    case _ (fail :protocol-order "the events begin with an end or a key, which a tree's never do")

def semver-step [s event]
  match (semver-top s)
    case :none (semver-root event)
    case [:done] (fail :protocol-order "the events hold more after the root value, which a tree's never do")
    case [:skip open] (semver-skip s open event)
    case [:ids name texts]
      match event
        case (scalar value) (transition (semver-mark [:ids name (push (semver-identifier name value) texts)] s) [])
        case array-end (semver-ids-end s name texts)
        case object-start (semver-fail (string-join "" ["an identifier of the " name " is an object"]))
        case array-start (semver-fail (string-join "" ["an identifier of the " name " is a list"]))
        case _ (fail :protocol-order "the events hold a key or an object's end inside a list, which a tree's never do")
    case [:version :key ma mi pa pr bu]
      match event
        case (key name) (semver-key s [:version :key ma mi pa pr bu] name)
        case object-end (transition [[:done]] [(semver-text [:version :key ma mi pa pr bu])])
        case _ (fail :protocol-order "the events hold a value where a key is due, which a tree's never do")
    case [:version [:value name] ma mi pa pr bu]
      match event
        case (scalar value) (semver-part s [:version [:value name] ma mi pa pr bu] name value)
        case object-start (semver-open s name :object)
        case array-start (semver-open s name :array)
        case _ (fail :protocol-order "the events hold a key or an end where a value is due, which a tree's never do")

def semver-finish [s]
  match (semver-top s)
    case [:done] []
    case :none (fail :protocol-order "the events hold no value, where a tree's hold one")
    case _ (fail :protocol-order "the events ended inside a container, which a tree's never do")

; The render: a version's events in, its text out.
def semver-render [input]
  join ""
    scan-emit [] semver-step semver-finish (events input)
